# Copy this file to `.env.local` and edit it. EVERY variable is optional.
# Never commit `.env.local` or any file that contains real passwords.

# Folder where the database (members, questions, results, study PDFs) is stored.
# Back this folder up. Default: ./data
# DATA_DIR=./data

# Keep the data in a Turso database (https://turso.tech) instead of in DATA_DIR. Use this on a hosting
# service whose disk is erased on every restart (for example the free plan of Render): set both values
# there. When TURSO_DATABASE_URL is set, DATA_DIR is not used. See docs/DEPLOYMENT.md.
# TURSO_DATABASE_URL=libsql://your-database-your-name.turso.io
# TURSO_AUTH_TOKEN=

# Admin password. If unset, a random password is generated on the first start
# and printed once in the terminal. If set, this value is always used (change it
# here to change the password; it can then not be changed in the admin screen).
# ADMIN_PASSWORD=

# Password that participants type to open the test screen. If unset, the admin
# sets it in the admin screen (Settings). If set here, it is managed here.
# PARTICIPANT_PASSWORD=

# Set to 1 when the app runs behind a reverse proxy or hosting platform that
# sets X-Forwarded-* headers (used for login rate limiting and cookies).
# On Render this is already on (Render sets RENDER=true); set 0 to turn it off.
# TRUST_PROXY=0

# Force the "Secure" flag on cookies. Automatic when the app is served over HTTPS.
# On Render this is already on; set 0 to turn it off.
# COOKIE_SECURE=0

# UI language for first-time visitors: en or ja. Default: the browser's language.
# DEFAULT_LANG=en
